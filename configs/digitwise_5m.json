{
  "model": {
    "architecture": "modern",
    "d_model": 288,
    "n_layers": 5,
    "n_heads": 6,
    "n_kv_heads": 6,
    "max_seq_len": 16,
    "qk_norm": true,
    "dropout": 0.0
  },
  "data": {
    "rule_family": "digitwise",
    "modulus": 100,
    "number_base": 10,
    "n_rule_relations": 16,
    "n_memory_relations": 16,
    "train_fraction": 0.75,
    "exposures_per_pair": 64,
    "seed": 17
  },
  "train": {
    "seed": 42,
    "steps": 8000,
    "batch_size": 512,
    "learning_rate": 0.0005,
    "min_learning_rate": 0.00005,
    "warmup_steps": 200,
    "weight_decay": 0.1,
    "eval_interval": 200,
    "log_interval": 20,
    "checkpoint_interval": 1000,
    "precision": "bf16",
    "device": "auto",
    "output_dir": "runs/digitwise_5m"
  },
  "probe": {
    "bits": [8, 6, 4, 3, 2],
    "seeds": [0, 1, 2, 3, 4, 5, 6, 7],
    "layerwise": true,
    "layer_bits": [4],
    "layer_seeds": [0, 1, 2],
    "batch_size": 512,
    "min_correct_per_group": 100
  }
}
